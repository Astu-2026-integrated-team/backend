# API Design — FuelGuard Backend

## Spec Authority

All endpoints are defined in `docs/FuelGuard_Backend_Spec.md`. Before designing any endpoint:
1. Read the relevant section in the spec
2. Implement exactly what the spec says
3. If the spec is ambiguous or wrong, update the spec first (own PR), then implement

---

## Express Route Structure

Every route file follows this exact pattern:

```javascript
// src/routes/vehicles.js
const express = require('express');
const router = express.Router();
const { authMiddleware } = require('../middleware/authMiddleware');
const vehicleService = require('../services/vehicleService');
const { validateVehicleCreate } = require('../validators/vehicleValidator');

/**
 * GET /api/vehicles
 * List all vehicles with current state
 * Auth: JWT required
 */
router.get('/', authMiddleware, async (req, res) => {
  try {
    const { status = 'all', deviceStatus = 'all' } = req.query;
    const vehicles = await vehicleService.listVehicles({ status, deviceStatus });
    return res.status(200).json({
      success: true,
      count: vehicles.length,
      vehicles
    });
  } catch (err) {
    return res.status(500).json({
      success: false,
      error: { code: 'INTERNAL_ERROR', message: err.message }
    });
  }
});

module.exports = router;
```

Rules:
- Route files contain ONLY routing logic. Zero business logic.
- All business logic lives in `src/services/`
- All validation lives in `src/validators/`
- All DB queries live in `src/db/repositories/`

---

## Response Shape Rules

### Success Response

```javascript
// Single resource
{ "success": true, "vehicle": { ...fields } }

// Collection
{ "success": true, "count": N, "vehicles": [...] }

// Created
{ "success": true, "vehicleId": "V001", "message": "Vehicle registered successfully" }

// Updated
{ "success": true, "vehicleId": "V001", "message": "Vehicle updated" }

// Accepted (telemetry)
{ "accepted": true, "telemetryId": "uuid", "vehicleId": "V001", "message": "telemetry stored" }
```

### Error Response (ALL errors use this shape)

```javascript
{
  "success": false,
  "error": {
    "code": "ERROR_CODE_CONSTANT",
    "message": "Human readable description"
  }
}
```

Never return a bare string as an error. Never use `error: "some string"`. Always use the `{ code, message }` object.

---

## HTTP Status Code Reference

| Scenario | Status | Error Code |
|---|---|---|
| Success, data returned | 200 | — |
| Created successfully | 201 | — |
| Invalid request body | 400 | `INVALID_PAYLOAD` |
| Business rule violation | 400 | `VALIDATION_ERROR` |
| Wrong credentials | 401 | `INVALID_CREDENTIALS` |
| No auth header | 401 | `MISSING_TOKEN` |
| Expired/invalid JWT | 401 | `INVALID_TOKEN` |
| Unknown device ID | 401 | `UNKNOWN_DEVICE` |
| Valid token, wrong role | 403 | `FORBIDDEN` |
| Resource not found | 404 | `NOT_FOUND` |
| Duplicate vehicle ID | 409 | `DUPLICATE_VEHICLE_ID` |
| Duplicate device ID | 409 | `DUPLICATE_DEVICE_ID` |
| Duplicate license number | 409 | `DUPLICATE_LICENSE` |
| Server error | 500 | `INTERNAL_ERROR` |

---

## Validation with Zod

Every POST/PATCH body MUST be validated with a Zod schema before touching the service layer.

```javascript
// src/validators/vehicleValidator.js
const { z } = require('zod');

const vehicleCreateSchema = z.object({
  vehicleId:          z.string().min(1).max(20),
  plateNumber:        z.string().min(1).max(20),
  label:              z.string().min(1).max(100),
  tankCapacityLiters: z.number().positive(),
  make:               z.string().optional(),
  model:              z.string().optional(),
  year:               z.number().int().min(1900).max(2100).optional(),
  color:              z.string().optional(),
  assignedDriverId:   z.string().optional(),
  assignedDeviceId:   z.string().optional(),
});

// Telemetry payload schema — mirrors hardware contract exactly
const telemetrySchema = z.object({
  t:           z.number().int().nonnegative(),
  fuel_l:      z.number(),
  fuel_pct:    z.number().int().min(0).max(100),
  engine:      z.boolean(),
  door:        z.boolean(),
  temp_c:      z.number(),
  accel_g:     z.number(),
  speed_kmh:   z.number().nonnegative(),
  rate_lhr:    z.number().nonnegative(),
  trip_sec:    z.number().int().nonnegative(),
  fuel_used:   z.number().nonnegative(),
  lat:         z.number().min(-90).max(90),
  lon:         z.number().min(-180).max(180),
  location:    z.string(),
  geofence_ok: z.boolean(),
  low_fuel:    z.boolean(),
  parking:     z.boolean(),
  overspeed:   z.boolean(),
  alert:       z.string().nullable(),
});

function validateTelemetry(body) {
  const result = telemetrySchema.safeParse(body);
  if (!result.success) {
    const firstError = result.error.errors[0];
    throw {
      statusCode: 400,
      code: 'INVALID_PAYLOAD',
      message: `${firstError.path.join('.')}: ${firstError.message}`
    };
  }
  return result.data;
}

module.exports = { vehicleCreateSchema, telemetrySchema, validateTelemetry };
```

