    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": ">=4.0.0",
    "typescript": ">=5.0.0",
    "vitest": "^4.1.5"
  }
